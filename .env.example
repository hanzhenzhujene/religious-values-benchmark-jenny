# Model provider credentials.
# OpenRouter is used for Qwen, DeepSeek, Llama, and Gemma.
OPENROUTER_API_KEY=

# MiniMax direct API is used for all MiniMax model lines.
MINIMAX_API_KEY=
CEI_MIN_MAX_TOKENS=2048

# Hugging Face access for gated official datasets.
# IslamTrust is gated and requires accepted access.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Optional local mirrors of official datasets.
# Leave blank to download from the official source.
ISLAMTRUST_DATASET=Abderraouf000/IslamTrust-benchmark
ISLAMTRUST_LANGUAGES=English,Arabic
ISLAMTRUST_DATA_FILE=

BUDDHISM_EVAL_DATASET=Nethmi14/BuddhismEval
BUDDHISM_EVAL_CONFIGS=english_eval,sinhala_eval
BUDDHISM_EVAL_SPLIT=train
BUDDHISM_EVAL_DATA_FILE=

BIBLEQA_DATA_URL=https://raw.githubusercontent.com/helen-jiahe-zhao/BibleQA/master/data/bible_qa/bible_qa_list_3_web.json
BIBLEQA_DATA_FILE=

# CatholicBench is blocked until official scenarios and rubrics are available.
CATHOLICBENCH_DATA_FILE=

# Runtime knobs.
CEI_TEMPERATURE=0
CEI_GENERATE_RETRIES=3
CEI_GENERATE_RETRY_DELAY_SECONDS=2
